# ==========================================
# SUPERSET - Secrets (generar con openssl)
# ==========================================
# SUPERSET_SECRET_KEY=  # openssl rand -base64 42
# POSTGRES_PASSWORD=    # openssl rand -base64 18
# REDIS_PASSWORD=       # openssl rand -base64 18

# ==========================================
# DATABRICKS - Connection (completar desde UI)
# ==========================================
# DATABRICKS_SERVER_HOSTNAME=  # ej. adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_HTTP_PATH=        # ej. /sql/1.0/warehouses/abc123def456
# DATABRICKS_CATALOG=          # ej. mi_catalogo_unity (desde Catalog Explorer)
# DATABRICKS_SCHEMA=           # gold
# DATABRICKS_TOKEN=            # PAT: Settings > Developer > Access tokens